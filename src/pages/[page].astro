---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', (p) => import.meta.env.DEV || !p.data.draft);
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <article>
    <h1>{page.data.title}</h1>
    {page.data.description && <p class="lede">{page.data.description}</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  article {
    padding-top: 2.5rem;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.5rem);
    font-weight: 600;
    color: var(--navy);
    margin: 0;
  }
  .lede {
    font-size: 1.4rem;
    line-height: 1.45;
    margin: 0.75rem 0 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  article {
    max-width: var(--measure);
  }
  .prose {
    margin-top: 2rem;
  }
</style>
