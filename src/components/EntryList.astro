---
// A table-of-contents style list: title, dotted leader, date.
import Plate from './Plate.astro';
import { formatDate, type Entry } from '../lib/content';
interface Props {
  entries: Entry[];
  dateStyle?: 'long' | 'year';
  showSection?: boolean;
  thumbs?: boolean;
}
const { entries, dateStyle = 'long', showSection = false, thumbs = false } = Astro.props;
const meta = (e: Entry) => {
  const d = e.data as Entry['data'] & { platform?: string; difficulty?: string };
  return [d.platform, d.difficulty].filter(Boolean).join(', ');
};
const sectionName: Record<string, string> = { projects: 'Project', writeups: 'Write-up', blog: 'Blog', notes: 'Note' };
---
<ol class:list={['contents', { thumbs }]}>
  {entries.map((e) => (
    <li>
      {thumbs && (
        <a href={`/${e.collection}/${e.id}/`} class="thumb" tabindex="-1" aria-hidden="true">
          <Plate cover={e.data.cover} alt="" seed={e.data.title} ratio="4 / 3" widths={[200, 400]} sizes="13rem" />
        </a>
      )}
      <div class="body">
      <a class="row" href={`/${e.collection}/${e.id}/`}>
        <span class="title">
          {e.data.title}
          {e.data.draft && <em class="draft"> (draft)</em>}
        </span>
        <span class="leader" aria-hidden="true"></span>
        <time datetime={e.data.date.toISOString()}>{formatDate(e.data.date, dateStyle)}</time>
      </a>
      {(e.data.description || showSection) && (
        <p class="desc">
          {showSection && <span class="kind">{sectionName[e.collection]}. </span>}
          {e.data.description}
        </p>
      )}
      {thumbs && meta(e) && <p class="meta">{meta(e)}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .contents {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li + li {
    margin-top: 1.1rem;
  }
  .thumbs li {
    display: grid;
    grid-template-columns: 13rem 1fr;
    gap: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--rule);
    align-items: start;
  }
  .thumbs li + li {
    margin-top: 1.75rem;
  }
  .thumbs li:last-child {
    border-bottom: 0;
  }
  .thumb {
    display: block;
  }
  .thumb:hover :global(.plate) {
    border-color: var(--red);
  }
  .meta {
    margin: 0.2rem 0 0;
    font-size: 1rem;
    font-style: italic;
    color: var(--gold);
  }
  .row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }
  .title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .row:hover .title {
    color: var(--navy);
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .leader {
    flex: 1;
    min-width: 1.5rem;
    border-bottom: 1.5px dotted var(--rule);
    transform: translateY(-0.3em);
  }
  time {
    color: var(--muted);
    font-size: 1.05rem;
    white-space: nowrap;
    font-variant-numeric: oldstyle-nums;
  }
  .desc {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 1.1rem;
    max-width: 44rem;
  }
  .kind {
    font-style: italic;
  }
  .draft {
    color: var(--gold);
    font-family: var(--serif);
    font-size: 1rem;
  }
  @media (max-width: 30rem) {
    .row { flex-wrap: wrap; }
    .thumbs li { grid-template-columns: 6rem 1fr; gap: 1rem; }
    .leader { display: none; }
    time { flex-basis: 100%; font-size: 1rem; }
  }
</style>
