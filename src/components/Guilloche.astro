---
// Engraved rosette (as on banknotes and share certificates), drawn from a seed
// string so every entry gets its own. `plate` fills a frame when an entry has
// no cover image; `medallion` is the round crest used on the home page.
interface Props {
  seed: string;
  label?: string;
  variant?: 'plate' | 'medallion';
  initials?: string;
}
const { seed, label = '', variant = 'plate', initials } = Astro.props;
const medallion = variant === 'medallion';
const W = medallion ? 260 : 400;
const H = medallion ? 260 : 250;
const cx = W / 2;
const cy = H / 2;

let h = 2166136261;
for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;

// Hypotrochoid with r = p/q: closes after p turns and shows q petals.
const ratios: [number, number][] = [[3, 7], [2, 9], [4, 11], [5, 13], [3, 10], [7, 17]];
const [p, q] = ratios[h % ratios.length];
const d = 0.55 + ((h >>> 8) % 30) / 100;

function rosette(scale: number, rot: number, dd: number) {
  const r = p / q;
  const k = 1 - r;
  const max = k + dd * r;
  const steps = q * 160;
  let path = '';
  for (let i = 0; i <= steps; i++) {
    const t = (i / steps) * Math.PI * 2 * p;
    const x = k * Math.cos(t) + dd * r * Math.cos((k / r) * t);
    const y = k * Math.sin(t) - dd * r * Math.sin((k / r) * t);
    const c = Math.cos(rot), s = Math.sin(rot);
    const px = cx + ((x * c - y * s) / max) * scale;
    const py = cy + ((x * s + y * c) / max) * scale;
    path += `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`;
  }
  return path;
}

const R = medallion ? 112 : 106;
const outer = rosette(R, 0, d);
const outer2 = medallion ? rosette(R, Math.PI / (2 * q), d) : '';
const middle = rosette(R * 0.74, Math.PI / q, Math.min(1, d + 0.25));
const inner = rosette(R * 0.4, 0, 0.9);

// Fine horizontal waves behind the rosette, like an engraved ground.
const waves = medallion
  ? []
  : Array.from({ length: 22 }, (_, i) => {
      const y0 = 8 + i * 11;
      let w = `M0 ${y0}`;
      for (let x = 0; x <= W; x += 10) w += `L${x} ${(y0 + Math.sin(x / 18 + i * 0.6) * 2.2).toFixed(1)}`;
      return w;
    });
---
<svg class:list={['guilloche', variant]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label={label}>
  {!medallion && <rect width={W} height={H} class="ground" />}
  {waves.length > 0 && <g class="waves">{waves.map((w) => <path d={w} />)}</g>}
  {medallion
    ? <>
        <circle cx={cx} cy={cy} r={R + 14} class="ring" />
        <circle cx={cx} cy={cy} r={R + 9} class="ring thin" />
      </>
    : <circle cx={cx} cy={cy} r={R + 8} class="halo" />}
  <path d={outer} class="line navy" />
  {outer2 && <path d={outer2} class="line navy" />}
  <path d={middle} class="line red" />
  {!initials && <path d={inner} class="line gold" />}
  {initials && (
    <>
      <circle cx={cx} cy={cy} r={R * 0.42} class="seal" />
      <circle cx={cx} cy={cy} r={R * 0.42} class="ring gold-ring" />
      <circle cx={cx} cy={cy} r={R * 0.42 - 5} class="ring thin" />
      <text x={cx} y={cy} text-anchor="middle" dominant-baseline="central" class="initials">{initials}</text>
    </>
  )}
</svg>

<style>
  .guilloche {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ground,
  .halo {
    fill: var(--paper-deep);
  }
  .waves path {
    fill: none;
    stroke: var(--rule);
    stroke-width: 0.8;
  }
  .line {
    fill: none;
    stroke-width: 0.9;
  }
  .medallion .line {
    stroke-width: 0.75;
  }
  .navy {
    stroke: var(--navy);
  }
  .red {
    stroke: var(--red);
  }
  .gold {
    stroke: var(--gold);
  }
  .ring {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2;
  }
  .gold-ring {
    stroke: var(--gold);
    stroke-width: 1.5;
  }
  .ring.thin {
    stroke-width: 0.8;
  }
  .seal {
    fill: var(--paper);
  }
  .initials {
    font-family: var(--display);
    font-weight: 500;
    font-size: 34px;
    letter-spacing: 1px;
    fill: var(--navy);
  }
</style>
