---
// A framed image, like a plate in an old book. Falls back to an engraved rosette.
import { Image } from 'astro:assets';
import Guilloche from './Guilloche.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  cover?: ImageMetadata;
  alt?: string;
  seed: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
  eager?: boolean;
}
const { cover, alt = '', seed, ratio = '8 / 5', widths = [400, 800, 1200], sizes = '(max-width: 44rem) 100vw, 40rem', eager = false } = Astro.props;
---
<div class="plate" style={`--ratio: ${ratio}`}>
  {cover
    ? <Image src={cover} alt={alt} widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
    : <Guilloche seed={seed} label={alt} />}
</div>

<style>
  .plate {
    padding: 5px;
    border: 1px solid var(--rule);
    background: var(--paper);
  }
  .plate > :global(*) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    outline: 1px solid color-mix(in srgb, var(--rule) 70%, transparent);
  }
</style>
